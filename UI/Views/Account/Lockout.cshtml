<!-- Views/Account/Lockout.cshtml -->
@{
    ViewData["Title"] = "Блокировка";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="fas fa-lock text-warning" style="font-size: 5rem;"></i>
                    </div>
                    <h2 class="text-warning mb-3">Учетная запись заблокирована</h2>
                    <p class="lead">Ваша учетная запись заблокирована из-за большого количества неудачных попыток входа.</p>
                    <p class="text-muted">Повторите попытку через 5 минут или обратитесь в техниескую поддержку.</p>
                    <hr />
                    <a asp-action="Login" asp-controller="Account" class="btn btn-warning">
                        <i class="fas fa-undo"></i> Повторить
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>