@{
}

@{
    ViewData["Title"] = "Ученики";
    var isStaff = User.IsInRole("Admin") || User.IsInRole("Coach");
    var isAdmin = User.IsInRole("Admin");
}

@section Styles {
    <link href="https://unpkg.com/tabulator-tables@6.3.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet" />
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Ученики</h2>
    @if (isStaff)
    {
        <button class="btn btn-primary" id="btnAdd"><i class="bi bi-plus-lg"></i> Добавить</button>
    }
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <input id="fSearch" class="form-control" placeholder="Поиск по фамилии / имени / родителю" />
    </div>
    <div class="col-md-3">
        <select id="fGroup" class="form-select"><option value="">Все группы</option></select>
    </div>
    <div class="col-md-2">
        <select id="fActive" class="form-select">
            <option value="">Все</option>
            <option value="true" selected>Активные</option>
            <option value="false">Неактивные</option>
        </select>
    </div>
</div>

<div id="playersTable"></div>

@if (isStaff)
{
    <div class="modal fade" id="playerModal" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" id="playerForm" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title">Ученик</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" />
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label">Фамилия</label><input name="lastName" class="form-control" required /></div>
                        <div class="col-6"><label class="form-label">Имя</label><input name="firstName" class="form-control" required /></div>
                        <div class="col-6"><label class="form-label">Дата рождения</label><input name="birthDate" type="date" class="form-control" required /></div>
                        <div class="col-6"><label class="form-label">Медсправка до</label><input name="medicalCertificateUntil" type="date" class="form-control" /></div>
                        <div class="col-12"><label class="form-label">Родитель</label><select name="parentId" class="form-select" required></select></div>
                        <div class="col-12"><label class="form-label">Группа</label><select name="groupId" class="form-select"><option value="">— без группы —</option></select></div>
                        <div class="col-12"><label class="form-label">Примечание</label><textarea name="note" class="form-control" rows="2"></textarea></div>
                        <div class="col-12 form-check ms-2">
                            <input name="isActive" type="checkbox" class="form-check-input" id="chkActive" checked />
                            <label class="form-check-label" for="chkActive">Активен</label>
                        </div>
                    </div>
                    <div class="alert alert-danger mt-3 d-none" id="formError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>
    <script>
        window.playersPage = { isStaff: @isStaff.ToString().ToLower(), isAdmin: @isAdmin.ToString().ToLower() };
    </script>
    <script src="~/js/player.js" asp-append-version="true"></script>
}