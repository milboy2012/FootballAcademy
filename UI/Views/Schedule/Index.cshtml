    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    ViewData["Title"] = "Расписание";
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Расписание академии</h2>
    @if (canEdit)
    {
        <button class="btn btn-primary" id="btnAdd"><i class="bi bi-plus-lg"></i> Добавить</button>
    }
</div>
<div class="row g-2 mb-3">
    <div class="col-md-3"><select id="fGroup" class="form-select"><option value="">Все группы</option></select></div>
    <div class="col-md-3"><select id="fVenue" class="form-select"><option value="">Все места</option></select></div>
    <div class="col-md-6 text-md-end small text-muted pt-2">
        <span class="badge" style="background:#3788d8">тренировка</span> <span class="badge bg-danger">матч</span> <span class="badge" style="background:#adb5bd">отменено</span>
    </div>
</div>
<div id="calendar"></div>

@if (canEdit)
{
    <div class="modal fade" id="evModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <form class="modal-content" id="evForm" novalidate>
                <div class="modal-header"><h5 class="modal-title" id="evTitle">Событие</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <input type="hidden" name="id" />
                    <div class="btn-group mb-3" role="group">
                        <input type="radio" class="btn-check" name="kind" id="kindT" value="Training" checked><label class="btn btn-outline-primary" for="kindT">Тренировка</label>
                        <input type="radio" class="btn-check" name="kind" id="kindM" value="Match"><label class="btn btn-outline-danger" for="kindM">Матч</label>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6"><label class="form-label">Группа *</label><select name="groupId" class="form-select" required></select></div>
                        <div class="col-md-6" id="oppWrap" style="display:none"><label class="form-label">Соперник *</label><select name="opponentGroupId" class="form-select"></select></div>
                        <div class="col-md-6"><label class="form-label">Место *</label><select name="venueId" class="form-select" required></select></div>
                        <div class="col-md-6"><label class="form-label">Дата *</label><input name="date" type="date" class="form-control" required /></div>
                        <div class="col-md-3"><label class="form-label">Начало *</label><input name="startTime" type="time" class="form-control" required step="300" /></div>
                        <div class="col-md-3"><label class="form-label">Окончание *</label><input name="endTime" type="time" class="form-control" required step="300" /></div>
                        <div class="col-12"><label class="form-label">Примечание</label><input name="note" class="form-control" /></div>
                    </div>

                    <div class="border rounded p-2 mt-3" id="recWrap">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="recOn" /><label class="form-check-label" for="recOn">Повторять еженедельно</label></div>
                        <div id="recBody" class="mt-2" style="display:none">
                            <div class="btn-group btn-group-sm mb-2" id="weekdays">
                                @foreach (var (n, i) in new[] { ("Пн", 1), ("Вт", 2), ("Ср", 3), ("Чт", 4), ("Пт", 5), ("Сб", 6), ("Вс", 0) })
                                {
                                    <input type="checkbox" class="btn-check" id="wd@i" value="@i"><label class="btn btn-outline-secondary" for="wd@i">@n</label>
                                }
                            </div>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4"><label class="form-label">До даты *</label><input name="until" type="date" class="form-control" /></div>
                                <div class="col-md-8 form-check ms-2"><input class="form-check-input" type="checkbox" id="skipConf" /><label class="form-check-label" for="skipConf">Пропускать занятые слоты</label></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-check mt-3"><input class="form-check-input" type="checkbox" id="notifyOn" checked /><label class="form-check-label" for="notifyOn">Уведомить участников и родителей</label></div>
                    <div class="alert alert-danger mt-3 d-none" id="evError"></div>
                    <div class="alert alert-warning mt-3 d-none" id="evConflicts"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger me-auto d-none" id="btnCancelEv">Отменить событие</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="cancelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Отмена события</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <label class="form-label">Причина (будет отправлена участникам)</label>
                    <input id="cancelReason" class="form-control" placeholder="Погодные условия, болезнь тренера…" />
                    <div class="form-check mt-2" id="cancelSeriesWrap"><input class="form-check-input" type="checkbox" id="cancelSeries" /><label class="form-check-label" for="cancelSeries">Отменить это и все последующие в серии</label></div>
                </div>
                <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Назад</button><button class="btn btn-danger" id="btnCancelConfirm">Отменить</button></div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="infoModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="infoTitle"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="infoBody"></div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/locales/ru.global.min.js"></script>
    <script>window.schedulePage = { canEdit: @canEdit.ToString().ToLower() };</script>
    <script src="~/js/schedule.js" asp-append-version="true"></script>
}