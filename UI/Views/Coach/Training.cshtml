    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Guid
@{
    ViewData["Title"] = "Проведение тренировки";
}

<a href="/Coach" class="text-decoration-none">&larr; К расписанию</a>
<div class="d-flex justify-content-between align-items-start mt-2 mb-3">
    <div><h2 class="mb-0" id="hTitle">…</h2><div class="text-muted" id="hSub"></div></div>
    <span class="badge fs-6" id="hStatus"></span>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Посещаемость</strong>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-success" id="btnAllPresent">Все присутствуют</button>
                    <span class="btn btn-light disabled" id="counter"></span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Игрок</th><th class="text-center" style="width:90px">Был</th><th style="width:150px">Причина</th><th>Комментарий</th></tr></thead>
                    <tbody id="rows"></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><strong>Заметки о тренировке</strong></div>
            <div class="card-body">
                <div class="mb-2 text-muted small" id="managerNote"></div>
                <label class="form-label">Что отрабатывали</label>
                <textarea id="summary" class="form-control mb-3" rows="5" placeholder="Разминка, передачи в парах, игра 4×4…"></textarea>
                <label class="form-label">Кто отличился</label>
                <textarea id="highlights" class="form-control" rows="3" placeholder="Иванов — лучшая работа в защите…"></textarea>
            </div>
        </div>
        <div class="alert alert-danger mt-3 d-none" id="err"></div>
        <div class="alert alert-success mt-3 d-none" id="ok"></div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-outline-primary" id="btnDraft">Сохранить</button>
            <button class="btn btn-success" id="btnComplete">Завершить тренировку</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>window.trainingId = '@Model';</script>
    <script src="~/js/coach-training.js" asp-append-version="true"></script>
}