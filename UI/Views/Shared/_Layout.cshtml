    @* Модальное окно для отображения изменения пароля *@
    @if (Context.Items["MustChangePassword"] is true)
{
    <div class="modal fade" id="forcePwdModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <form class="modal-content" id="forcePwdForm" method="post" asp-controller="Account" asp-action="ChangePassword">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title">Задайте свой пароль</h5></div>
                <div class="modal-body">
                    <p class="text-muted">Вы вошли с временным паролем. Для продолжения работы придумайте собственный.</p>
                    <div class="mb-2">
                        <label class="form-label">Временный пароль</label>
                        <input name="CurrentPassword" type="password" class="form-control" required autocomplete="current-password" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Новый пароль</label>
                        <input name="NewPassword" type="password" class="form-control" required minlength="6" autocomplete="new-password" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Повторите пароль</label>
                        <input name="ConfirmPassword" type="password" class="form-control" required autocomplete="new-password" />
                    </div>
                    <div class="form-text">Минимум 6 символов, заглавная и строчная буква, цифра, спецсимвол.</div>
                    <div class="alert alert-danger mt-3 d-none" id="forcePwdError"></div>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-link" href="#" onclick="document.getElementById('logoutForm').submit();return false;">Выйти</a>
                    <button type="submit" class="btn btn-primary">Сохранить и продолжить</button>
                </div>
            </form>
        </div>
    </div>
    <script>
            (() => {
                const m = new bootstrap.Modal('#forcePwdModal'); m.show();
                const f = document.getElementById('forcePwdForm'), err = document.getElementById('forcePwdError');
                f.addEventListener('submit', async e => {
                    e.preventDefault();
                    if (f.NewPassword.value !== f.ConfirmPassword.value) {
                        err.textContent = 'Пароли не совпадают'; err.classList.remove('d-none'); return;
                    }
                    const r = await fetch(f.action, { method: 'POST', body: new FormData(f) });
                    const body = await r.json().catch(() => null);
                    if (r.ok) { location.href = body.redirect || '/'; return; }
                    err.textContent = body?.error ?? `Ошибка ${r.status}`; err.classList.remove('d-none');
                });                

            })();            
                
    </script>
    }


    @await RenderSectionAsync("Scripts", required: false)

    
</body>
