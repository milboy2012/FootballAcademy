@using Core.Entity
@model List<Player>
@{
   
}



<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h1><i class="fas fa-users"></i> Игроки академии</h1>
        </div>
        <div class="col text-end">
            <a href="@Url.Action("Create")" class="btn btn-success">
                <i class="fas fa-plus"></i> Добавить игрока
            </a>
        </div>
    </div>

    <!-- Контейнер для Tabulator -->
    <div id="players-table"></div>
</div>

@section Styles {
    <style>
        /* Кастомная стилизация Tabulator */
        #players-table {
            height: 600px;
        }
        .tabulator-row .tabulator-cell {
            padding: 8px 10px;
        }
        .badge-position {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
    </style>
}


