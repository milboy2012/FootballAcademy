                    'Полузащитник': 'badge bg-warning text-dark',
                    'Защитник': 'badge bg-info',
                    'Вратарь': 'badge bg-success'
                };
                return `<span class="${colors[position] || 'badge bg-secondary'}">${position}</span>`;
