@{
    var isStaff = User.IsInRole("Manager") || User.IsInRole("Coach");
    var canEdit = User.IsInRole("Manager");
    ViewData["Title"] = "Публикации";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Публикации</h2>
    @if (isStaff)
    {
        <button class="btn btn-primary" id="btnAdd"><i class="bi bi-plus-lg"></i> Добавить</button>
    }
</div>

<div id="postsTable"></div>

